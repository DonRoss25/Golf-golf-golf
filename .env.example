# --- Core app ---
# Postgres connection string (Vercel Postgres, Neon, Supabase, Railway, etc).
DATABASE_URL="postgresql://user:password@host:5432/dbname"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Your deployed URL in production (e.g. https://your-app.vercel.app).
NEXTAUTH_URL="http://localhost:3000"

# --- GHIN integration (USGA Golf Handicap Information Network) ---
# GHIN does not offer open self-serve API signup; access requires a
# licensing agreement with the USGA/your state golf association.
# Once you have credentials, set these and src/lib/ghin.ts will use the
# real API instead of its built-in mock data.
GHIN_API_BASE_URL=""
GHIN_API_KEY=""
GHIN_USER_EMAIL=""
GHIN_USER_PASSWORD=""

# --- Live PGA Tour stats/scores ---
# No official free public API. Plug in a licensed provider (e.g. SportRadar
# Golf API, SlashGolf/RapidAPI PGA Tour endpoints, or the PGA Tour's own
# partner feed) here. src/lib/pga.ts falls back to mock data when unset.
PGA_STATS_API_BASE_URL=""
PGA_STATS_API_KEY=""

# --- Betting odds aggregation (FanDuel via a licensed odds provider) ---
# FanDuel does not publish a public odds API. Use a licensed aggregator
# such as The Odds API (https://the-odds-api.com) which re-broadcasts
# FanDuel's lines alongside other books; filter to bookmaker "fanduel".
ODDS_API_BASE_URL="https://api.the-odds-api.com/v4"
ODDS_API_KEY=""

# --- Closest-to-pin photo storage ---
# Without this set, photos are written to /public/uploads for local dev
# (won't persist on serverless hosts). In production, create a Vercel Blob
# store (Vercel dashboard -> Storage -> Blob) and set its read/write token
# here; src/lib/storage.ts switches to it automatically when present.
BLOB_READ_WRITE_TOKEN=""
